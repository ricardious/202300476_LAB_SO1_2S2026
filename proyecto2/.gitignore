# ============================================================================
# .gitignore del Proyecto 2 — artefactos locales que NO se versionan.
# ============================================================================

# Binario del daemon compilado localmente.
bin/

# El .env local jamás se versiona; .env.example SÍ (contrato del proyecto).
.env
!.env.example

# Logs generados por el generador/cron.
logs/

# Reportes completos del host generados al capturar evidencias localmente.
docs/evidencias/kernel/kernel.txt
docs/evidencias/kernel/proc-snapshot.json

# Objetos intermedios del módulo de kernel y del frente eBPF de inspección.
kernel/*.o
kernel/*.ko
kernel/*.mod
kernel/*.mod.c
kernel/*.order
kernel/*.symvers
kernel/.*.cmd
kernel/.tmp_versions/
ebpf/kill_monitor.o
