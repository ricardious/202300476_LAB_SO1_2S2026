# ============================================================================
# .env.example — Variables del Proyecto 2 de SO1 (Carnet 202300476)
#
# Copie a .env (cp .env.example .env) y ajuste según su entorno.
# Todas las variables tienen valores por defecto seguros en el daemon.
# ============================================================================

# --- Ruta /proc expuesta por el módulo del kernel --------------------------
SO1_P2_PROC_PATH=/proc/continfo_pr2_so1_202300476

# --- Docker ----------------------------------------------------------------
SO1_P2_DOCKER_HOST=unix:///var/run/docker.sock
SO1_P2_DOCKER_API_VERSION=1.41

# --- Valkey ----------------------------------------------------------------
SO1_P2_VALKEY_ADDR=127.0.0.1:6379
SO1_P2_VALKEY_PASSWORD=
SO1_P2_VALKEY_DB=0
SO1_P2_KEY_PREFIX=so1:p2:

# --- Loop de reconciliación (20-60 s) --------------------------------------
SO1_P2_LOOP_INTERVAL=20s

# --- Cuotas de conservación (mínimos obligatorios) --------------------------
SO1_P2_MIN_LOW=3
SO1_P2_MIN_HIGH=2

# --- Contratos de protección y gestión --------------------------------------
# Nombres protegidos REALES de Compose (nunca candidatos a eliminación).
SO1_P2_PROTECTED_NAMES=so1-p2-grafana,so1-p2-valkey,grafana,valkey
# Etiqueta que marca un contenedor como inmune.
SO1_P2_PROTECTED_LABELS=so1.p2.protect=1
# Etiqueta con la que el daemon reconoce los contenedores gestionados.
SO1_P2_MANAGED_LABEL_KEY=so1.p2.managed
SO1_P2_MANAGED_LABEL_VALUE=1

# --- Señal y confirmación eBPF ----------------------------------------------
SO1_P2_KILL_SIGNAL=SIGKILL
SO1_P2_KILL_TIMEOUT=2s
SO1_P2_CONFIRMATION_TIMEOUT=30s

# --- eBPF -------------------------------------------------------------------
# auto     = intenta el puente CO-RE real; degrada a consumidor nulo solo si
#            el entorno no tiene privilegios (sin root/CAP_BPF).
# required = exige eBPF real; sin privilegios el daemon NO arranca.
# off      = desactiva eBPF explícitamente (sin confirmación de eliminaciones).
SO1_P2_EBPF_MODE=auto

# --- Módulo de kernel (scripts idempotentes) --------------------------------
SO1_P2_LOAD_MODULE_ON_START=true
SO1_P2_UNLOAD_MODULE_ON_STOP=false
SO1_P2_MODULE_LOAD_SCRIPT=scripts/load-module.sh
SO1_P2_MODULE_UNLOAD_SCRIPT=scripts/unload-module.sh

# --- Compose (Valkey + Grafana) ---------------------------------------------
# Ruta del archivo Compose; vacío desactiva el auto-arranque desde el daemon.
SO1_P2_COMPOSE_FILE=deploy/docker-compose.yml
SO1_P2_COMPOSE_DOWN_ON_STOP=false

# --- Cron (generador de contenedores cada 2 minutos) ------------------------
SO1_P2_CRON_SCHEDULE=*/2 * * * *
# Ruta instalada por `make install`; debe coincidir con install-cron.sh.
SO1_P2_CRON_COMMAND=/usr/local/bin/so1-p2-generate-containers.sh

# --- Compose / Grafana (solo lectura por scripts/Makefile) ------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
VALKEY_PORT=6379

# --- Generador de carga (solo lectura por scripts) --------------------------
# Semilla fija para reproducción de pruebas (vacío = aleatorio real).
SO1_SEED=
# Nº de contenedores por invocación de cron (debe ser 5).
SO1_CONTAINERS_COUNT=5
# Duración nominal de cada workload en minutos.
SO1_RUN_MINUTES=10
# Raíz del proyecto (contiene workloads/). El generador la autodetecta; esta
# variable se usa cuando se invoca desde una instalación en /usr/local/bin.
# Ajuste la ruta a su clon real (rama ricardious/p2-delivery).
SO1_P2_PROJECT_DIR=/home/usuario/202300476_LAB_SO1_2S2026/proyecto2